// Ribbons of aurora over a night sky.
func band(y: float, center: float, width: float) -> float {
    return smoothstep(width, 0.0, abs(y - center))
}

fragment background(uv: vec2) -> color {
    var c = mix(vec3(0.02, 0.04, 0.10), vec3(0.05, 0.08, 0.18), uv.y)
    let g = band(uv.y, 0.32 + 0.07 * sin(uv.x * 5.0), 0.12)
    let v = band(uv.y, 0.46 + 0.05 * sin(uv.x * 7.0 + 1.3), 0.10)
    c += vec3(0.30, 0.85, 0.70) * g * 0.45
    c += vec3(0.55, 0.50, 1.00) * v * 0.35
    return vec4(c, 1.0)
}
