// Xtronic Frost — static soft-focus backdrop for the start page.
// Hypertheme background shaders are rasterized to a PNG by the host;
// this shader deliberately uses no time uniform.
func glow(p: vec2, center: vec2, radius: float) -> float {
    let d = length(p - center)
    return 1.0 - smoothstep(0.0, radius, d)
}

fragment background(uv: vec2) -> color {
    let aspect = resolution.x / resolution.y
    let p = (uv - vec2(0.5, 0.5)) * vec2(aspect, 1.0)

    var c = vec3(0.035, 0.050, 0.067)
    c += vec3(0.055, 0.105, 0.135) * glow(p, vec2(-0.48, -0.28), 0.92)
    c += vec3(0.040, 0.075, 0.115) * glow(p, vec2(0.46, 0.30), 0.88)
    c += vec3(0.025, 0.055, 0.070) * glow(p, vec2(0.05, -0.62), 0.72)

    let lowerFade = smoothstep(0.25, 1.0, uv.y)
    c = mix(c, vec3(0.025, 0.037, 0.050), lowerFade * 0.42)
    return vec4(c, 1.0)
}
