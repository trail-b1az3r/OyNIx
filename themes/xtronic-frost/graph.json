    {
      "id": "icefield_shader",
      "type": "shader",
      "x": 40,
      "y": 650,
      "props": {
        "code": "// Xtronic Frost — a layered, soft-focus icefield backdrop.\n// This is a still .hypertheme backdrop: the host rasterizes it to PNG.\n// Curved light ribbons, diffused blooms and fine contour lines give it depth\n// without bright neon bands or harsh geometric shapes.\n\nfunc soft_glow(p: vec2, center: vec2, radius: float) -> float {\n    let d = length(p - center)\n    return 1.0 - smoothstep(0.0, radius, d)\n}\n\nfunc ribbon(y: float, center: float, width: float) -> float {\n    return 1.0 - smoothstep(width * 0.28, width, abs(y - center))\n}\n\nfragment background(uv: vec2) -> color {\n    let aspect = resolution.x / resolution.y\n    let p = (uv - vec2(0.5, 0.5)) * vec2(aspect, 1.0)\n\n    // Deep graphite-blue base with two broad, low-contrast light blooms.\n    var c = vec3(0.030, 0.045, 0.060)\n    c += vec3(0.045, 0.105, 0.135) * soft_glow(p, vec2(-0.42, -0.18), 0.98)\n    c += vec3(0.035, 0.070, 0.125) * soft_glow(p, vec2(0.46, 0.20), 0.86)\n    c += vec3(0.035, 0.032, 0.070) * soft_glow(p, vec2(0.08, -0.62), 0.68)\n\n    // Two long, overlapping aurora ribbons. Their curvature is spatial,\n    // so the pattern remains stable in the host's cached PNG renderer.\n    let wave_a = -0.15 + 0.105 * sin(p.x * 2.35 + 0.45) + 0.030 * cos(p.x * 5.2 - 0.7)\n    let wave_b = 0.22 + 0.080 * sin(p.x * 1.85 - 1.15) + 0.022 * cos(p.x * 4.6 + 0.4)\n\n    let halo_a = ribbon(p.y, wave_a, 0.205)\n    let core_a = ribbon(p.y, wave_a, 0.042)\n    let halo_b = ribbon(p.y, wave_b, 0.155)\n    let core_b = ribbon(p.y, wave_b, 0.032)\n\n    let xfade = clamp(uv.x * 0.92 + 0.04, 0.0, 1.0)\n    let ice = mix(vec3(0.055, 0.205, 0.285), vec3(0.105, 0.340, 0.425), xfade)\n    let periwinkle = mix(vec3(0.105, 0.135, 0.245), vec3(0.105, 0.245, 0.335), xfade)\n    c += ice * halo_a * 0.22\n    c += vec3(0.16, 0.43, 0.52) * core_a * 0.19\n    c += periwinkle * halo_b * 0.20\n    c += vec3(0.20, 0.30, 0.43) * core_b * 0.16\n\n    // Barely visible concentric contours in the left bloom add texture\n    // without reading as a grid or a bright decorative pattern.\n    let orbit = length((p - vec2(-0.43, 0.18)) * vec2(0.88, 1.12))\n    let orbit_phase = abs(fract(orbit * 8.0) - 0.5)\n    let contours = 1.0 - smoothstep(0.012, 0.050, orbit_phase)\n    c += vec3(0.025, 0.050, 0.064) * contours * 0.42\n\n    // Soft vignette keeps the edges quiet and lets page content remain clear.\n    let edge = length(vec2(p.x * 0.72, p.y * 0.92))\n    let vignette = smoothstep(0.34, 0.92, edge)\n    c = mix(c, vec3(0.018, 0.028, 0.039), vignette * 0.52)\n\n    // A very slight deterministic grain avoids an overly synthetic flat fill.\n    let pixel = floor(uv * resolution)\n    let grain = fract(sin(dot(pixel, vec2(12.9898, 78.233))) * 43758.5453)\n    c += vec3(grain - 0.5, grain - 0.5, grain - 0.5) * 0.004\n\n    return vec4(c, 1.0)\n}\n"
      }
